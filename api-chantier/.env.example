# Used by docker compose (and local overrides)

POSTGRES_USER=chantier
POSTGRES_PASSWORD=chantier
POSTGRES_DB=chantier
POSTGRES_PORT=5432

API_PORT=3000

JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*

# Local node (outside Docker) — host maps to published Postgres port
DATABASE_URL=postgres://chantier:chantier@localhost:5432/chantier
PORT=3000
NODE_ENV=development

# Imp-09 SSE (optional)
SSE_HEARTBEAT_MS=30000
SSE_RETRY_MS=3000

# Imp-10 Wave A — in-process jobs (optional; no REST / no Redis)
JOBS_ENABLED=true
JOBS_POLL_MS=50
JOBS_MAX_ATTEMPTS=3
JOBS_BACKOFF_CAP_MS=2000

# MinIO object storage
MINIO_ENABLED=true
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=chantier-assets
MINIO_PUBLIC_HOST=localhost:9000

# Public FE URL (password-reset links)
APP_PUBLIC_URL=http://localhost:16035

# SMTP (optional — emails logged when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@chantier.local
