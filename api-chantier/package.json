{
  "name": "api-chantier",
  "version": "0.1.0",
  "description": "Chantier BTP timesheet API — Express.js modular + PostgreSQL (migration from Supabase)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "check": "node --check src/server.js && node --check src/app.js",
    "test": "node --env-file=.env.test --test test/**/*.test.js",
    "test:unit": "node --env-file=.env.test --test test/**/*.test.js",
    "migrate": "node src/db/cli.js up",
    "migrate:status": "node src/db/cli.js status",
    "migrate:test": "node --env-file=.env.test src/db/cli.js up",
    "seed:local": "node scripts/seed-local.js",
    "docker:up": "docker compose -f docker-compose.yml -f docker-compose.phase13.yml up -d --build",
    "docker:up:phase13": "docker compose -f docker-compose.yml -f docker-compose.phase13.yml up -d --build",
    "docker:down": "docker compose -f docker-compose.yml -f docker-compose.phase13.yml down",
    "docker:test:up": "docker compose -f docker-compose.test.yml up -d",
    "docker:test:down": "docker compose -f docker-compose.test.yml down",
    "docker:logs": "docker compose -f docker-compose.yml -f docker-compose.phase13.yml logs -f api db web",
    "docker:ps": "docker compose -f docker-compose.yml -f docker-compose.phase13.yml ps"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.16.0",
    "zod": "^3.25.28"
  }
}
